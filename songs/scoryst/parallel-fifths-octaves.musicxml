<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  A teaching demo of PARALLEL FIFTHS and PARALLEL OCTAVES.

  Two voices share one treble staff (voice 1 stems up, voice 2 stems down,
  written one after another with <backup>). The number printed under each beat
  is the harmonic interval between the two voices.

  The point is aural: when both voices move in the same direction keeping a
  perfect fifth (or octave), the perfect consonance blends so completely that
  the ear stops hearing two independent lines and hears one thickened line
  instead. That loss of independence is why classical part-writing forbids
  consecutive perfect fifths and octaves. Each faulty example is followed by the
  same top line re-harmonised with thirds and sixths and some contrary motion,
  where the two voices stay independent. Play the MIDI to hear the difference.

  divisions=1 (1 = quarter). Title is drawn in parallel-fifths-octaves.typ.
-->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1"><part-name print-object="no">Two voices</part-name></score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <direction placement="above">
        <direction-type><metronome parentheses="no"><beat-unit>quarter</beat-unit><per-minute>88</per-minute></metronome></direction-type><sound tempo="88"/>
      </direction>
      <direction placement="above">
        <direction-type><words font-weight="bold" default-y="48">Parallel fifths</words></direction-type>
      </direction>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>quarter</type><stem>up</stem><lyric number="1"><syllabic>single</syllabic><text>5</text></lyric></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>quarter</type><stem>up</stem><lyric number="1"><syllabic>single</syllabic><text>5</text></lyric></note>
